# Copy this file to .env and fill in the values. Never commit .env.

# --- Mobile app (public values, bundled into the app) ---
# Supabase dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server secrets (Supabase Edge Functions only, never in the app) ---
# Set them with: npx supabase secrets set --env-file supabase/functions/.env
# See supabase/functions/.env.example
