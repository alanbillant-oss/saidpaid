# Server-side secrets for the Edge Functions. Copy to supabase/functions/.env (git-ignored).
# Upload with: npx supabase secrets set --env-file supabase/functions/.env

# https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# https://console.deepgram.com > API Keys (speech-to-text)
DEEPGRAM_API_KEY=...

# --- WhatsApp channel (Meta WhatsApp Business Cloud API), see README > WhatsApp ---
# developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=...
# A permanent token from a System User (Business Settings > System users), not the 24h test token
WHATSAPP_ACCESS_TOKEN=...
# developers.facebook.com > your app > App settings > Basic > App secret
WHATSAPP_APP_SECRET=...
# Any random string you choose, pasted again in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=...
# The Saidpaid WhatsApp number people write to, international format (e.g. +33612345678)
WHATSAPP_DISPLAY_NUMBER=...
# Language of the WhatsApp replies: fr or en
WHATSAPP_REPLY_LANG=fr
